<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des articles</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Conteneur général */
.container {
  max-width: 1000px;
  margin: 2rem auto;
  padding: 1rem;
  font-family: 'Segoe UI', sans-serif;
}

/* Titre */
h2 {
  text-align: center;
  margin-bottom: 1.5rem;
  color: #333;
}

/* Table */
table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 1rem;
  background-color: #fff;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
}

/* En-têtes */
thead {
  background-color: #007bff;
  color: white;
}

th {
  padding: 0.75rem;
  text-align: left;
  font-weight: 600;
  border-bottom: 2px solid #dee2e6;
}

/* Cellules */
td {
  padding: 0.75rem;
  border-bottom: 1px solid #dee2e6;
  color: #333;
}

/* Alternance de lignes */
tbody tr:nth-child(even) {
  background-color: #f8f9fa;
}

/* Hover */
tbody tr:hover {
  background-color: #e2e6ea;
  cursor: pointer;
}

/* Bouton */
.btn {
  display: inline-block;
  margin-top: 1rem;
  padding: 0.5rem 1rem;
  background-color: #28a745;
  color: white;
  text-decoration: none;
  border-radius: 4px;
  font-weight: bold;
}

.btn:hover {
  background-color: #218838;
}

/* Responsive */
@media (max-width: 768px) {
  table, thead, tbody, th, td, tr {
    display: block;
  }

  thead {
    display: none;
  }

  tr {
    margin-bottom: 1rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 0.5rem;
    background-color: #fff;
  }

  td {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem;
    border: none;
    border-bottom: 1px solid #eee;
  }

  td::before {
    content: attr(data-label);
    font-weight: bold;
    color: #555;
  }
}
  </style>
</head>
<body>
  <div class="container">
    <h2>📦 Liste des articles enregistrés</h2>

    <% if (articles.length === 0) { %>
      <p>Aucun article trouvé.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Référence</th>
            <th>Désignation</th>
            <th>N° Série</th>
            <th>Quantité</th>
            <th>Position</th>
            <th>État</th>
            <th>Service</th>
            <th>Section</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% articles.forEach(article => { %>
            <tr>
              <td><%= article.reference %></td>
              <td><%= article.designation %></td>
              <td><%= article.n_serie %></td>
              <td><%= article.qte %></td>
              <td><%= article.position %></td>
              <td><%= article.etat %></td>
              <td><%= article.service %></td>
              <td><%= article.section %></td>
              <td><%= article.date ? article.date.toISOString().split('T')[0] : '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <a href="/articles/new" class="btn">➕ Ajouter un article</a>
  </div>
</body>
</html>
